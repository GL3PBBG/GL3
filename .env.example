# Postgres 16 connection string used by the server and drizzle-kit
DATABASE_URL=postgres://gl3:gl3@localhost:5432/gl3
# Redis 7 connection string used for sessions, cooldowns, BullMQ and pub/sub
REDIS_URL=redis://localhost:6379
# MariaDB 10.11 admin connection used ONLY by apps/migrate's test suite to
# create/drop per-test-file isolated V2 fixture databases (gl3_test_mysql_*).
# Never used against a real production V2 database — gl3-migrate's own
# --mysql flag takes a full connection string per invocation, unrelated to this.
MYSQL_ADMIN_URL=mysql://gl3_migrate_root:gl3_migrate_root@127.0.0.1:3306/mysql
# HTTP port the Fastify server binds
PORT=3000
# Comma-separated origin allowlist. Strict per spec §7 — a wildcard is refused
# at boot. Defaults to the Vite dev server; production wants the real origin.
CORS_ORIGINS=http://localhost:5173
# development | test | production
NODE_ENV=development
# Session token lifetime in seconds (7 days)
SESSION_TTL=604800
# --- Plugins ---
# Which bundled plugin set loads at boot.
#   full      — every first-party plugin: the gangster game (default).
#   framework — the game-agnostic engine only (openPBBG-shaped): ranks,
#               notifications, news, bank, mail, forum, inventory, membership.
#               Jail/hospital, the sentence sweeper, the wealth tax and the
#               gameplay seeds are all skipped; add plugins back individually
#               with PLUGIN_IDS (e.g. GL3_PROFILE=framework PLUGIN_IDS=crimes).
GL3_PROFILE=full
# Comma-separated manifest ids selecting among plugins COMPILED INTO this
# server (the generated apps/server/src/plugins/installed-plugins.ts). The 12
# gameplay plugins are listed there AND auto-loaded by GL3_PROFILE=full; under
# GL3_PROFILE=framework this is the only way they load. The 8 framework
# plugins are never listed here — they load in every profile.
PLUGIN_IDS=
# Comma-separated npm package specifiers imported at boot from OUTSIDE this
# build. These load unconditionally: naming one here is the enabling act, so
# there is no id to also add to PLUGIN_IDS. This is the only way to add a
# plugin to the published container image, whose runtime stage carries no
# toolchain and cannot rebuild the static import map.
PLUGIN_PACKAGES=
# Directory PLUGIN_PACKAGES are resolved from — in production a mounted volume
# populated by an init container running:
#   npm i --prefix /data/plugins @acme/plugin-x
# Leave unset to resolve them from the server's own node_modules instead, which
# is what a from-source deployment wants.
# PLUGIN_DIR=/data/plugins
# npm.gl3.dev access token (npm login --registry https://npm.gl3.dev) — the
# app-profile `plugins` installer service needs it to install premium
# @gl3-plugins/* packages into the plugins-data volume.
GL3_NPM_TOKEN=

# Milliseconds between sentence-sweeper passes (ends elapsed jail/hospital
# sentences without waiting for the player to ask). 0 disables the sweeper;
# the lazy release-on-request path is unaffected either way.
SWEEP_INTERVAL_MS=2000

# --- Game art (assets) ---
# Which object-storage backend holds uploaded images.
#   fs — a directory on this machine, served by the server's own /assets/:key
#        route. The default, and what the test suite uses.
#   s3 — any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO), served from
#        ASSET_CDN_BASE. The five S3_*/ASSET_CDN_BASE values below become
#        REQUIRED and are validated at boot, not at first upload.
ASSET_DRIVER=fs
# Filesystem root for ASSET_DRIVER=fs. Relative paths resolve against the
# process cwd. Gitignored.
ASSET_FS_ROOT=var/assets
# S3-compatible endpoint. For R2: https://<account-id>.r2.cloudflarestorage.com
#S3_ENDPOINT=
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# `auto` for Cloudflare R2; a real region for AWS.
S3_REGION=auto
# Public base URL images are served from. Objects are content-addressed and
# immutable, so this can sit behind a CDN with a one-year cache.
#ASSET_CDN_BASE=https://cdn.example.com

# --- Outbound mail ---
# Which backend sends verify/reset email.
#   log    — prints to stdout. The default, and what the test suite uses.
#   resend — POSTs to api.resend.com. RESEND_API_KEY becomes REQUIRED and is
#            validated at boot, not at first send.
EMAIL_DRIVER=log
#RESEND_API_KEY=
# From address for outbound mail.
EMAIL_FROM=noreply@gl3.dev
# Web origin used to build links in outbound mail (verify, reset).
APP_BASE_URL=http://localhost:5173
