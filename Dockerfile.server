# syntax=docker/dockerfile:1
#
# Server image: API + WebSocket gateway. Built from compiled TypeScript.
#
# The builder runs `tsc --build` against @gl3/server, which follows its
# tsconfig reference to @gl3/shared and emits BOTH packages/shared/dist and
# apps/server/dist in one step — so no separate `build -w @gl3/shared` is
# needed here (unlike Dockerfile.web, where Vite — not tsc — resolves
# @gl3/shared and needs dist present before the web build starts).
#
# argon2 ships a linux-x64 musl prebuild, so node:22-alpine needs no
# build toolchain (no python/make/g++).
#
# Schema bootstrap: the server CMD (index.js) does NOT run migrations. For a
# fresh database, run `node apps/server/dist/db/migrate.js` as a Rancher
# initContainer before the server starts. The image ships the compiled
# migrator and the drizzle/ SQL so that entrypoint works from this image
# alone — no separate migration tooling. Migrations are idempotent (drizzle
# tracks applied files in the __drizzle_migrations table), so re-running on
# an already-bootstrapped database is a no-op.

ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

# Copy manifests first for the install layer. npm ci validates the workspace
# layout, so all four package.json files must be present.
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/

RUN npm ci

# Copy the TypeScript sources and tsconfigs that the build reads.
COPY tsconfig.json tsconfig.base.json ./
COPY packages/shared/tsconfig.json packages/shared/tsconfig.json
COPY packages/shared/src packages/shared/src
COPY apps/server/tsconfig.json apps/server/tsconfig.json
COPY apps/server/src apps/server/src
# Migrations are TS-adjacent SQL, not compiled; copy the source dir so the
# runtime stage can serve them to the compiled migrator.
COPY apps/server/drizzle apps/server/drizzle

# Point at the server project directly rather than the root tsconfig.json.
# The root tsconfig references all three projects (shared, server, web), but
# only shared + server are copied into this image — web is not, so building
# from root fails with TS5083 (Cannot read apps/web/tsconfig.json). The server
# project's own references pull in packages/shared, so both dist/ dirs are
# produced; `--force` matches `npm run typecheck` (rebuild from scratch, since
# .dockerignore excluded any cached .tsbuildinfo).
RUN npx tsc --build --force apps/server/tsconfig.json

# --- runtime stage -----------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /app

# Same manifests as the builder, then a production-only install. This recreates
# the node_modules/@gl3/shared workspace symlink, which is how the runtime
# resolves `@gl3/shared` through its package.json exports map.
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/

RUN npm ci --omit=dev

# Compiled output from the builder. drizzle/ ships too so the migrator
# entrypoint (dist/db/migrate.js) can find its SQL — it resolves
# ../../drizzle relative to dist/db/, i.e. apps/server/drizzle.
COPY --from=builder /app/packages/shared/dist packages/shared/dist
COPY --from=builder /app/apps/server/dist apps/server/dist
COPY --from=builder /app/apps/server/drizzle apps/server/drizzle

USER node
EXPOSE 3000

# /health is registered in src/app.ts and covered by test/health.test.ts.
# wget is present in the alpine base; curl is not.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1

CMD ["node", "apps/server/dist/index.js"]
