{
  "name": "@gl3/migrate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": { "gl3-migrate": "./dist/cli.js" },
  "scripts": {
    "build": "tsc --build && npm run bundle",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/cli.js --allow-overwrite",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@gl3/plugin-bounties": "*",
    "@gl3/plugin-detectives": "*",
    "@gl3/plugin-theft": "*",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.11.5",
    "postgres": "^3.4.5",
    "uuidv7": "^1.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "tsx": "^4.19.2"
  }
}
