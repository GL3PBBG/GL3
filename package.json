{
  "name": "gl3",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*", "packages/plugins/*", "examples/*"],
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:nodb": "vitest run --project @gl3/server:unit --project @gl3/shared --project @gl3/plugin-sdk --project @gl3/web",
    "verify": "npm run typecheck && npm run test",
    "verify:ci": "npm run typecheck && npm run test:nodb",
    "test:related": "vitest related --run",
    "verify:related": "npm run typecheck && node scripts/verify-related.mjs",
    "plugins:generate": "node scripts/generate-plugin-map.mjs",
    "db:clean-clones": "node scripts/drop-stale-test-clones.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.9.0"
  }
}
